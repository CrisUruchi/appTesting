### Variables
@baseUrl = http://localhost:5000
@contentType = application/json

### ============================================
### 01 - Listar todos los productos
### ============================================
GET {{baseUrl}}/api/productos
Accept: {{contentType}}

### ============================================
### 02 - Obtener un producto por ID
### ============================================
# @name obtenerProducto
GET {{baseUrl}}/api/productos/1
Accept: {{contentType}}

### ============================================
### 03 - Crear producto válido
### ============================================
# @name crearProducto
POST {{baseUrl}}/api/productos
Content-Type: {{contentType}}

{
    "nombre": "Laptop HP",
    "descripcion": "Laptop 15 pulgadas, 16GB RAM",
    "precio": 1500.50,
    "fecha_vencimiento": "2026-12-31"
}

### ============================================
### 04 - Crear producto con precio negativo (400)
### ============================================
POST {{baseUrl}}/api/productos
Content-Type: {{contentType}}

{
    "nombre": "Producto Inválido",
    "descripcion": "Precio negativo",
    "precio": -100,
    "fecha_vencimiento": "2026-12-31"
}

### ============================================
### 05 - Crear producto con fecha pasada (400)
### ============================================
POST {{baseUrl}}/api/productos
Content-Type: {{contentType}}

{
    "nombre": "Producto Vencido",
    "descripcion": "Fecha en el pasado",
    "precio": 100,
    "fecha_vencimiento": "2020-01-01"
}

### ============================================
### 06 - Crear producto con nombre vacío (400)
### ============================================
POST {{baseUrl}}/api/productos
Content-Type: {{contentType}}

{
    "nombre": "",
    "descripcion": "Sin nombre",
    "precio": 100,
    "fecha_vencimiento": "2026-12-31"
}

### ============================================
### 07 - Actualizar producto (PUT)
### ============================================
PUT {{baseUrl}}/api/productos/1
Content-Type: {{contentType}}

{
    "nombre": "Laptop HP Actualizada",
    "descripcion": "Ahora con 32GB RAM",
    "precio": 1800.00,
    "fecha_vencimiento": "2027-06-30"
}

### ============================================
### 08 - Obtener producto inexistente (404)
### ============================================
GET {{baseUrl}}/api/productos/999999
Accept: {{contentType}}

### ============================================
### 09 - Eliminar producto (DELETE)
### ============================================
DELETE {{baseUrl}}/api/productos/1
Accept: {{contentType}}

### ============================================
### 10 - Listar productos después de eliminar
### ============================================
GET {{baseUrl}}/api/productos
Accept: {{contentType}}

### ============================
### 11 - Crear producto y guardar id
### ============================
# @name crearProd
POST {{baseUrl}}/api/productos
Content-Type: {{contentType}}

{
    "nombre": "tomate rojito",
    "descripcion": "podrido, que no lo note el usuario",
    "precio": 5,
    "fecha_vencimiento": "2026-12-31"
}

### Usar el id devuelto en el request anterior
GET {{baseUrl}}/api/productos/{{crearProd.response.body.$.id}}
Accept: {{contentType}}